{
  "version": 8,
  "name": "Abtin Night",
  "metadata": {
    "manus:description": "Magic Earth inspired dark style for Abtin Navigator"
  },
  "sources": {
    "openfreemap": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/tiles.json"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#1a202c"
      }
    },
    {
      "id": "landuse_park",
      "type": "fill",
      "source": "openfreemap",
      "source-layer": "landuse",
      "filter": ["==", "class", "park"],
      "paint": {
        "fill-color": "#1b3a27"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openfreemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#1a365d"
      }
    },
    {
      "id": "roads_major",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "paint": {
        "line-color": "#4a5568",
        "line-width": {
          "base": 1.4,
          "stops": [[6, 0.5], [12, 3], [16, 15]]
        }
      }
    }
  ]
}
